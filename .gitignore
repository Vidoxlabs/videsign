# Assets and Media
*.png
!brand/repo-banners/**/*.png
# Chibi reference set (ADR-028): committed at the canon chibi canvas so agents
# can read a correct target. Masters and generation sidecars stay local.
!canon/vwxyz/chibi/**/*.png
*.jpg
*.jpeg
*.gif
*.svg
!brand/**/*.svg
*.mp4
*.mov
*.webp
node_modules/
.DS_Store

# Generated token artifacts (run `npm run tokens` to regenerate)
dist/
_site/
.worktrees/

# Local-only asset staging: nothing inside assets/ is committed except its
# README (AGENTS.md: local-only design images; ADR-002 bans rasters).
# Pre-review candidates and generation run records stay local and are
# never scanned into git by accident.
assets/*
!assets/README.md
!assets/.gitkeep

# Build leftovers from the repo-banners generator
__pycache__/
*.pyc
