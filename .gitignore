# Assets and Media
*.png
*.jpg
*.jpeg
*.gif
*.svg
!brand/**/*.svg
*.mp4
*.mov
*.webp
node_modules/
.DS_Store

# Generated token artifacts (run `npm run tokens` to regenerate)
dist/
.worktrees/

# Local-only asset staging: nothing inside assets/ is committed except its
# README (AGENTS.md: local-only design images; ADR-002 bans rasters).
# Pre-review candidates and generation run records stay local and are
# never scanned into git by accident.
assets/*
!assets/README.md
!assets/.gitkeep
